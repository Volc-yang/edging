{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "edgeworld.universe.realistic-presentation-profile.v0.1"
    },
    "evidence_class": {
      "enum": [
        "synthetic-contract-only",
        "source-inputs-pending-native-import",
        "native-observed-proposal"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,95}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ue_version": {
          "const": "5.8.3"
        },
        "platform": {
          "const": "Mac"
        },
        "rhi": {
          "const": "Metal"
        }
      },
      "required": [
        "ue_version",
        "platform",
        "rhi"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "world_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,95}$"
        },
        "expected_build": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_options": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_assets": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unit_transform": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "projection_version": {
          "const": "basicshapes-proxy.v0.2"
        }
      },
      "required": [
        "world_id",
        "expected_build",
        "expected_options",
        "authority_assets",
        "unit_transform",
        "projection_version"
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,95}$"
        },
        "bounds_xy_cm": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "place_id",
        "bounds_xy_cm"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_uri": {
            "type": "string",
            "minLength": 1
          },
          "license_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "required": [
          "file_id",
          "path",
          "byte_count",
          "sha256",
          "source_uri",
          "license_ref"
        ]
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          },
          "kind": {
            "enum": [
              "static_mesh",
              "material"
            ]
          },
          "object_path": {
            "type": "string",
            "pattern": "^/Game/EdgeWorldRealism/[A-Za-z0-9_/]+\\.[A-Za-z0-9_]+$"
          },
          "source_file_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,95}$"
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,95}$"
            }
          },
          "native_import": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "const": "unresolved"
                  },
                  "source_unit_cm": {
                    "type": "null"
                  },
                  "pivot_cm": {
                    "type": "null"
                  },
                  "bounds_cm": {
                    "type": "null"
                  },
                  "material_slots": {
                    "type": "null"
                  },
                  "evidence_ref": {
                    "type": "null"
                  }
                },
                "required": [
                  "status",
                  "source_unit_cm",
                  "pivot_cm",
                  "bounds_cm",
                  "material_slots",
                  "evidence_ref"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "const": "native-observed"
                  },
                  "source_unit_cm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "pivot_cm": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "bounds_cm": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {
                      "type": "number"
                    }
                  },
                  "material_slots": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "evidence_ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  }
                },
                "required": [
                  "status",
                  "source_unit_cm",
                  "pivot_cm",
                  "bounds_cm",
                  "material_slots",
                  "evidence_ref"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "const": "native-observed"
                  },
                  "source_unit_cm": {
                    "type": "null"
                  },
                  "pivot_cm": {
                    "type": "null"
                  },
                  "bounds_cm": {
                    "type": "null"
                  },
                  "material_slots": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "evidence_ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  }
                },
                "required": [
                  "status",
                  "source_unit_cm",
                  "pivot_cm",
                  "bounds_cm",
                  "material_slots",
                  "evidence_ref"
                ]
              }
            ]
          }
        },
        "required": [
          "asset_id",
          "kind",
          "object_path",
          "source_file_ids",
          "dependencies",
          "native_import"
        ]
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "binding_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          },
          "place_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          },
          "place_kind": {
            "enum": [
              "city",
              "wildland",
              "plain",
              "forest",
              "river_marsh",
              "ocean"
            ]
          },
          "role": {
            "enum": [
              "vegetation",
              "rock",
              "ground",
              "water"
            ]
          },
          "geometry_source": {
            "enum": [
              "declared-mesh",
              "verified-place-region"
            ]
          },
          "mesh_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "material_bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slot_name": {
                  "type": "string",
                  "minLength": 1
                },
                "material_asset_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,95}$"
                }
              },
              "required": [
                "slot_name",
                "material_asset_id"
              ]
            }
          }
        },
        "required": [
          "binding_id",
          "place_id",
          "place_kind",
          "role",
          "geometry_source",
          "mesh_asset_id",
          "material_bindings"
        ]
      }
    },
    "derived_recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "explicit-list.v0.1"
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instance_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,95}$"
              },
              "binding_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,95}$"
              },
              "position_cm": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer"
                }
              },
              "rotation_mdeg": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer"
                }
              },
              "scale_ppm": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "required": [
              "instance_id",
              "binding_id",
              "position_cm",
              "rotation_mdeg",
              "scale_ppm"
            ]
          }
        }
      },
      "required": [
        "algorithm",
        "instances"
      ]
    },
    "missing_asset_policy": {
      "const": "reject-preserve-last-complete-view"
    },
    "fallback": {
      "const": "forbidden"
    },
    "collision": {
      "const": "none"
    },
    "presentation_clock": {
      "const": "local-only"
    },
    "presentation_mode": {
      "const": "realistic-readonly-sidecar.v0.1"
    },
    "material_recipes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "material_asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          },
          "blend_mode": {
            "enum": [
              "Opaque",
              "Masked"
            ]
          },
          "mask_cutoff": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "two_sided": {
            "type": "boolean"
          },
          "textures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "enum": [
                    "BaseColor",
                    "Normal",
                    "Occlusion",
                    "Roughness",
                    "Metallic",
                    "OpacityMask"
                  ]
                },
                "source_file_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,95}$"
                },
                "channels": {
                  "enum": [
                    "R",
                    "G",
                    "B",
                    "RGB",
                    "A"
                  ]
                },
                "srgb": {
                  "type": "boolean"
                },
                "normal_basis": {
                  "enum": [
                    "DirectX",
                    "OpenGL",
                    null
                  ]
                }
              },
              "required": [
                "role",
                "source_file_id",
                "channels",
                "srgb",
                "normal_basis"
              ]
            }
          }
        },
        "required": [
          "material_asset_id",
          "blend_mode",
          "mask_cutoff",
          "two_sided",
          "textures"
        ]
      }
    }
  },
  "required": [
    "format",
    "evidence_class",
    "profile_id",
    "target",
    "authority",
    "region",
    "files",
    "assets",
    "bindings",
    "derived_recipe",
    "missing_asset_policy",
    "fallback",
    "collision",
    "presentation_clock",
    "presentation_mode",
    "material_recipes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgeworld:universe:realistic-presentation-profile:v0.1:synthetic-contract"
}
