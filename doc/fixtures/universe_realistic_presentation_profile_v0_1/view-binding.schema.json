{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "edgeworld.universe.realistic-view-binding.v0.1"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,95}$"
    },
    "manifest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "const": ""
        }
      ]
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "watermark": {
      "type": "integer",
      "minimum": 0
    },
    "unit_transform": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "view_generation": {
      "type": "integer",
      "minimum": 1
    },
    "authority_projection_version": {
      "const": "basicshapes-proxy.v0.2"
    },
    "presentation_mode": {
      "const": "realistic-readonly-sidecar.v0.1"
    },
    "renderer_build_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "world_id",
    "manifest",
    "state",
    "event",
    "tick",
    "revision",
    "watermark",
    "unit_transform",
    "profile_sha256",
    "view_generation",
    "authority_projection_version",
    "presentation_mode",
    "renderer_build_sha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
