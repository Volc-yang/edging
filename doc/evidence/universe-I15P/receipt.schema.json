{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "authority_root": {
          "minLength": 1,
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "type": "integer"
        },
        "host_pid": {
          "minimum": 1,
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "session": {
          "enum": [
            "initialize",
            "existing"
          ]
        },
        "source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "worker_pid": {
          "minimum": 1,
          "type": "integer"
        },
        "world_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authority_root",
        "generation",
        "host_pid",
        "run_id",
        "session",
        "source_sha",
        "worker_pid",
        "world_id"
      ],
      "type": "object"
    },
    "clock": {
      "additionalProperties": false,
      "properties": {
        "anchor_monotonic": {
          "minimum": 0,
          "type": "number"
        },
        "anchor_utc": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "anchor_monotonic",
        "anchor_utc",
        "id"
      ],
      "type": "object"
    },
    "cua": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "calls": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "minLength": 1,
                "type": "string"
              },
              "completed_monotonic": {
                "minimum": 0,
                "type": "number"
              },
              "log_after_offset": {
                "minimum": 0,
                "type": "integer"
              },
              "log_before_offset": {
                "minimum": 0,
                "type": "integer"
              },
              "raw_tool_ref": {
                "$ref": "#/$defs/reference"
              },
              "started_monotonic": {
                "minimum": 0,
                "type": "number"
              },
              "step_id": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "command",
              "completed_monotonic",
              "log_after_offset",
              "log_before_offset",
              "raw_tool_ref",
              "started_monotonic",
              "step_id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "format": {
          "const": "universe-i15-probe-cua.v1"
        }
      },
      "required": [
        "action_id",
        "binding",
        "calls",
        "clock",
        "format"
      ],
      "type": "object"
    },
    "head": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "tick": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "watermark": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "tick",
        "watermark"
      ],
      "type": "object"
    },
    "history_rejection_state": {
      "additionalProperties": false,
      "properties": {
        "can_write": {
          "const": false
        },
        "format": {
          "const": "universe-i13-history-rejection.v1"
        },
        "handled_input": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rejected_input"
            }
          ]
        },
        "handler_counts": {
          "additionalProperties": false,
          "properties": {
            "Retain": {
              "minimum": 0,
              "type": "integer"
            },
            "SpacePressed": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "Retain",
            "SpacePressed"
          ],
          "type": "object"
        },
        "r_down": {
          "const": false
        },
        "space_down": {
          "const": false
        }
      },
      "required": [
        "can_write",
        "format",
        "handled_input",
        "handler_counts",
        "r_down",
        "space_down"
      ],
      "type": "object"
    },
    "readback": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action_id": {
                "const": "p1.history_write_rejected"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "$ref": "#/$defs/history_rejection_state"
              }
            }
          }
        }
      ],
      "properties": {
        "action_id": {
          "minLength": 1,
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "event_serial": {
          "minimum": 1,
          "type": "integer"
        },
        "format": {
          "const": "universe-i15-probe-readback.v1"
        },
        "origin": {
          "enum": [
            "query",
            "input",
            "verified_observation",
            "release"
          ]
        },
        "selected_observation": {
          "$ref": "#/$defs/head"
        },
        "stage": {
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "type": "object"
        },
        "trusted_head": {
          "$ref": "#/$defs/head"
        }
      },
      "required": [
        "action_id",
        "binding",
        "event_serial",
        "format",
        "origin",
        "selected_observation",
        "stage",
        "state",
        "trusted_head"
      ],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "rejected_input": {
      "additionalProperties": false,
      "properties": {
        "counter_after": {
          "minimum": 1,
          "type": "integer"
        },
        "counter_before": {
          "minimum": 0,
          "type": "integer"
        },
        "event": {
          "const": "pressed"
        },
        "handled": {
          "const": true
        },
        "handler": {
          "enum": [
            "SpacePressed",
            "Retain"
          ]
        },
        "key": {
          "enum": [
            "Space",
            "R"
          ]
        },
        "reason": {
          "const": "history_read_only"
        },
        "rejected": {
          "const": true
        }
      },
      "required": [
        "counter_after",
        "counter_before",
        "event",
        "handled",
        "handler",
        "key",
        "reason",
        "rejected"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "enum": [
        "p1.startup",
        "p1.probe",
        "p1.camera",
        "p1.visibility",
        "p1.framerate",
        "p1.pause",
        "p1.history",
        "p1.history_write_rejected",
        "p1.held_input",
        "p1.final",
        "p1.exit"
      ]
    },
    "after": {
      "$ref": "#/$defs/reference"
    },
    "before": {
      "$ref": "#/$defs/reference"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "checkpoints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command_index": {
            "minimum": -1,
            "type": "integer"
          },
          "event_serial": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "log_end": {
            "minimum": 0,
            "type": "integer"
          },
          "log_start": {
            "minimum": 0,
            "type": "integer"
          },
          "map": {
            "$ref": "#/$defs/reference"
          },
          "read_monotonic": {
            "minimum": 0,
            "type": "number"
          },
          "stage": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "command_index",
          "event_serial",
          "log_end",
          "log_start",
          "map",
          "read_monotonic",
          "stage"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "clock": {
      "$ref": "#/$defs/clock"
    },
    "completed_monotonic": {
      "minimum": 0,
      "type": "number"
    },
    "cua": {
      "$ref": "#/$defs/reference"
    },
    "format": {
      "const": "universe-i15-probe-actions.v1"
    },
    "image_checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capture_id": {
            "type": "string"
          },
          "capture_ref": {
            "$ref": "#/$defs/reference"
          },
          "stage": {
            "type": "string"
          }
        },
        "required": [
          "capture_id",
          "stage",
          "capture_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "after_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "before_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "device": {
          "minimum": 0,
          "type": "integer"
        },
        "inode": {
          "minimum": 0,
          "type": "integer"
        },
        "prefix_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "after_offset",
        "before_offset",
        "device",
        "inode",
        "prefix_sha256",
        "ref"
      ],
      "type": "object"
    },
    "selected_observation": {
      "$ref": "#/$defs/head"
    },
    "started_monotonic": {
      "minimum": 0,
      "type": "number"
    },
    "trace_range": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "trusted_head": {
      "$ref": "#/$defs/head"
    }
  },
  "required": [
    "action_id",
    "after",
    "before",
    "binding",
    "checkpoints",
    "clock",
    "completed_monotonic",
    "cua",
    "format",
    "image_checks",
    "log",
    "selected_observation",
    "started_monotonic",
    "trace_range",
    "trusted_head"
  ],
  "title": "universe-i15-probe-actions.v1",
  "type": "object"
}
