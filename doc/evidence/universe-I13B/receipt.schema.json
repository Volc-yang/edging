{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "authority_root": {
          "minLength": 1,
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "type": "integer"
        },
        "host_pid": {
          "minimum": 1,
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "session": {
          "enum": [
            "initialize",
            "existing"
          ]
        },
        "source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "worker_pid": {
          "minimum": 1,
          "type": "integer"
        },
        "world_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authority_root",
        "generation",
        "host_pid",
        "run_id",
        "session",
        "source_sha",
        "worker_pid",
        "world_id"
      ],
      "type": "object"
    },
    "clock": {
      "additionalProperties": false,
      "properties": {
        "anchor_monotonic": {
          "minimum": 0,
          "type": "number"
        },
        "anchor_utc": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "anchor_monotonic",
        "anchor_utc",
        "id"
      ],
      "type": "object"
    },
    "cua": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "calls": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "minLength": 1,
                "type": "string"
              },
              "completed_monotonic": {
                "minimum": 0,
                "type": "number"
              },
              "raw_tool_ref": {
                "$ref": "#/$defs/reference"
              },
              "started_monotonic": {
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "command",
              "completed_monotonic",
              "raw_tool_ref",
              "started_monotonic"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "format": {
          "const": "universe-i13-cua.v1"
        }
      },
      "required": [
        "action_id",
        "binding",
        "calls",
        "clock",
        "format"
      ],
      "type": "object"
    },
    "head": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "tick": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "watermark": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "tick",
        "watermark"
      ],
      "type": "object"
    },
    "readback": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "format": {
          "const": "universe-i13-readback.v1"
        },
        "selected_observation": {
          "$ref": "#/$defs/head"
        },
        "stage": {
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "type": "object"
        },
        "trusted_head": {
          "$ref": "#/$defs/head"
        }
      },
      "required": [
        "action_id",
        "binding",
        "format",
        "selected_observation",
        "stage",
        "state",
        "trusted_head"
      ],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "enum": [
        "s1.initialize",
        "s1.probe",
        "s1.native_ids",
        "s1.native_assets",
        "s1.retain",
        "s1.physical",
        "s1.retry",
        "s1.history",
        "s1.history_select",
        "s1.history_write_rejected",
        "s1.held_input",
        "s1.camera",
        "s1.visibility",
        "s1.framerate",
        "s1.pause",
        "s1.final",
        "s1.exit",
        "s2.recover",
        "s2.probe",
        "s2.revisit",
        "s2.final",
        "s2.exit"
      ]
    },
    "after": {
      "$ref": "#/$defs/reference"
    },
    "before": {
      "$ref": "#/$defs/reference"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "checkpoints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "after_command": {
            "minimum": -1,
            "type": "integer"
          },
          "log_end": {
            "minimum": 0,
            "type": "integer"
          },
          "log_start": {
            "minimum": 0,
            "type": "integer"
          },
          "map": {
            "$ref": "#/$defs/reference"
          },
          "monotonic": {
            "minimum": 0,
            "type": "number"
          },
          "stage": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "after_command",
          "log_end",
          "log_start",
          "map",
          "monotonic",
          "stage"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "clock": {
      "$ref": "#/$defs/clock"
    },
    "completed_monotonic": {
      "minimum": 0,
      "type": "number"
    },
    "cua": {
      "$ref": "#/$defs/reference"
    },
    "format": {
      "const": "universe-i13-actions.v1"
    },
    "image_checks": {
      "items": {
        "$ref": "#/$defs/reference"
      },
      "type": "array"
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "after_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "before_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "device": {
          "minimum": 0,
          "type": "integer"
        },
        "inode": {
          "minimum": 0,
          "type": "integer"
        },
        "prefix_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "after_offset",
        "before_offset",
        "device",
        "inode",
        "prefix_sha256",
        "ref"
      ],
      "type": "object"
    },
    "selected_observation": {
      "$ref": "#/$defs/head"
    },
    "started_monotonic": {
      "minimum": 0,
      "type": "number"
    },
    "trace_range": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "trusted_head": {
      "$ref": "#/$defs/head"
    }
  },
  "required": [
    "action_id",
    "after",
    "before",
    "binding",
    "checkpoints",
    "clock",
    "completed_monotonic",
    "cua",
    "format",
    "image_checks",
    "log",
    "selected_observation",
    "started_monotonic",
    "trace_range",
    "trusted_head"
  ],
  "title": "universe-i13-actions.v1",
  "type": "object"
}
